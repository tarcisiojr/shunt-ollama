#!/usr/bin/env python3
"""Resume o log do shunt: decisões dos hooks, delegações ao bulk-read, tokens
que ficaram fora do contexto do Claude e quanto de cada arquivo entrou.

Responde sozinho as três perguntas que antes exigiam ler os transcripts das
sessões: uma mudança surtiu efeito (comparação por versão), quanto de cada
arquivo chegou ao contexto (cobertura) e se isso aconteceu em fatias pequenas
(fatiamento).

Uso: shunt-stats [--log CAMINHO] [--since AAAA-MM-DD] [--version 0.5.0] [--model NOME]
                 [--follow [--all]]
                 [--top N] [--file TRECHO]
"""

import argparse
import collections
import datetime as dt
import statistics
import os
import sys
import time

DEFAULT_LOG = os.environ.get("SHUNT_HOOK_LOG") or os.path.expanduser(
    "~/.claude/shunt.log")
CONVERSION_WINDOW = dt.timedelta(minutes=10)
# Média medida no tokenizador do gemma sobre shell, Go, markdown e JSON.
BYTES_PER_TOKEN = 3.0
LEGACY_VERSION = "<=0.3.0"
NOT_HOOK = ("bulk-read", "SessionStart")
# Uma leitura desse tamanho ou menor conta como fatia, para separar
# exploração em pedaços de leitura cirúrgica. Em bytes, como a decisão.
SLICE_BYTES = 3000
SLICE_LINES = 80


def parse_line(line):
    """Aceita 8 colunas (antes da versão), 9 (0.4.0), 11 (0.5.0) e 13 (0.9.0).

    A partir da 0.9.0 a decisão é em bytes e as colunas 12 e 13 os trazem;
    antes disso só havia linhas, e as seções por byte ficam sem dado."""
    cols = line.rstrip("\n").split("\t")
    if len(cols) not in (8, 9, 11, 13):
        return None
    try:
        ts = dt.datetime.fromisoformat(cols[0])
    except ValueError:
        return None
    wide = len(cols) >= 11
    return {"ts": ts, "session": cols[1], "tool": cols[2], "decision": cols[3],
            "reason": cols[4], "path": cols[5], "total": int(cols[6] or 0),
            "eff": int(cols[7] or 0),
            "version": cols[8] if len(cols) >= 9 else LEGACY_VERSION,
            "ranges": cols[9] if wide else "-",
            "covered": int(cols[10] or 0) if wide else 0,
            "total_bytes": int(cols[11] or 0) if len(cols) == 13 else 0,
            "read_bytes": int(cols[12] or 0) if len(cols) == 13 else 0}


def kv(reason):
    out = {}
    for part in reason.split(";"):
        if "=" in part:
            k, v = part.split("=", 1)
            out[k] = int(v) if v.isdigit() else v
    return out


def version_key(version):
    if version == LEGACY_VERSION:
        return (0,)
    parts = version.split(".")
    if all(p.isdigit() for p in parts):
        return (1,) + tuple(int(p) for p in parts)
    return (2, version)


def pick_deny(pending, delegation):
    """A negativa que esta delegação atendeu, ou None.

    Primeiro a do mesmo arquivo dentro da janela; sem ela, só a mais recente
    dentro da janela. Uma delegação casa com uma negativa, nunca com todas:
    a regra anterior dava dezesseis negativas como convertidas por uma
    delegação de um arquivo só, e escondia que o Claude desistiu das outras.
    Delegação de vários arquivos grava só o primeiro, então os demais caem
    no pareamento por tempo.
    """
    window = [d for d in pending
              if d["ts"] <= delegation["ts"] <= d["ts"] + CONVERSION_WINDOW]
    same_path = [d for d in window if d["path"] == delegation["path"]]
    if same_path:
        return same_path[-1]
    return window[-1] if window else None


def converted_denies(denies, bulk_ok):
    """As negativas atendidas, uma por delegação, na ordem do log."""
    pending = sorted(denies, key=lambda d: d["ts"])
    converted = []
    for b in sorted(bulk_ok, key=lambda r: r["ts"]):
        d = pick_deny(pending, b)
        if d is not None:
            pending.remove(d)
            converted.append(d)
    return converted


def conversions(denies, bulk_ok):
    return len(converted_denies(denies, bulk_ok))


def print_conversion_by_tool(denies, bulk_ok):
    """Conversão por ferramenta que sofreu a negativa.

    Cada usuário tem as suas ferramentas MCP, e uma sandbox que devolve só
    resumo (context-mode, por exemplo) pode estar sendo bloqueada sem
    necessidade; é aqui que isso aparece, ferramenta a ferramenta.
    """
    if not denies:
        return
    converted = converted_denies(denies, bulk_ok)
    by_tool = collections.defaultdict(lambda: [0, 0])
    for d in denies:
        by_tool[d["tool"]][0] += 1
    for d in converted:
        by_tool[d["tool"]][1] += 1
    if len(by_tool) < 2:
        return
    print("  por ferramenta:")
    for tool, (total, conv) in sorted(by_tool.items(), key=lambda x: -x[1][0]):
        print(f"    {conv:>3}/{total:<3} ({100 * conv / total:>3.0f}%)  {tool}")


def summarize(rows):
    hooks = [r for r in rows if r["tool"] not in NOT_HOOK]
    denies = [r for r in hooks if r["decision"] == "deny"]
    bulk = [r for r in rows if r["tool"] == "bulk-read"]
    bulk_ok = [r for r in bulk if r["decision"] == "ok"]
    entered = sum(r["eff"] for r in hooks if r["decision"] == "allow")
    blocked = sum(r["eff"] for r in denies)
    total = entered + blocked
    return {
        "events": len(hooks), "denies": len(denies),
        "entered": entered, "blocked": blocked,
        "rate": (100 * blocked / total) if total else 0.0,
        "entered_bytes": sum(r["read_bytes"] for r in hooks
                             if r["decision"] == "allow"),
        "blocked_bytes": sum(r["read_bytes"] for r in denies),
        "delegations": len(bulk_ok), "delegation_errors": len(bulk) - len(bulk_ok),
        "converted": conversions(denies, bulk_ok),
        "sessions": len({r["session"] for r in hooks if r["session"] != "-"}),
        "sent": sum(kv(r["reason"]).get("pin", 0) for r in bulk_ok),
        "returned": sum(kv(r["reason"]).get("pout", 0) for r in bulk_ok),
        "seconds": sum(kv(r["reason"]).get("dur", 0) for r in bulk_ok),
        "files": sum(kv(r["reason"]).get("files", 0) for r in bulk_ok),
        "ratios": [kv(r["reason"]).get("ratio") for r in bulk_ok
                   if kv(r["reason"]).get("ratio") is not None],
    }


def print_version_table(rows):
    by_version = collections.defaultdict(list)
    for r in rows:
        by_version[r["version"]].append(r)
    versions = sorted(by_version, key=version_key)

    print("Comparação por versão (entrou/bloqueado em tokens estimados)")
    header = (f"  {'versão':<10} {'eventos':>8} {'negativas':>10} "
              f"{'entrou':>9} {'bloqueado':>10} {'taxa':>6} "
              f"{'delegações':>11} {'conversão':>10}")
    print(header)
    print("  " + "-" * (len(header) - 2))
    for v in versions:
        s = summarize(by_version[v])
        conv = f"{100 * s['converted'] / s['denies']:.0f}%" if s["denies"] else "-"
        deleg = str(s["delegations"])
        if s["delegation_errors"]:
            deleg += f"+{s['delegation_errors']}!"
        # Antes da 0.9.0 o log só tinha linhas; ali a estimativa é por linha.
        if s["entered_bytes"] or s["blocked_bytes"]:
            entrou = int(s["entered_bytes"] / BYTES_PER_TOKEN)
            bloqueado = int(s["blocked_bytes"] / BYTES_PER_TOKEN)
        else:
            entrou, bloqueado = s["entered"] * 12, s["blocked"] * 12
        taxa = (100 * bloqueado / (entrou + bloqueado)) if entrou + bloqueado else 0
        print(f"  {v:<10} {s['events']:>8} {s['denies']:>10} "
              f"{entrou:>9} {bloqueado:>10} {taxa:>5.0f}% "
              f"{deleg:>11} {conv:>10}")

    if len(versions) > 1:
        a = summarize(by_version[versions[-2]])
        b = summarize(by_version[versions[-1]])
        print(f"\n  {versions[-2]} -> {versions[-1]}: taxa de bloqueio "
              f"{a['rate']:.0f}% -> {b['rate']:.0f}%", end="")
        if a["denies"] and b["denies"]:
            print(f", conversão {100 * a['converted'] / a['denies']:.0f}%"
                  f" -> {100 * b['converted'] / b['denies']:.0f}%", end="")
        print()
        if b["events"] < 30:
            print(f"  Atenção: só {b['events']} eventos na versão mais recente; "
                  "amostra pequena para concluir.")
    print()


def print_model_table(rows):
    """Uma linha por modelo do Ollama, para comparar trocas de SHUNT_MODEL.

    O nome vem do `model=` gravado pelo bulk-read a partir da 0.11.0; linhas
    anteriores caem em "(sem registro)" para não sumirem da conta.
    """
    bulk = [r for r in rows if r["tool"] == "bulk-read"]
    if not bulk:
        return
    by_model = collections.defaultdict(list)
    for r in bulk:
        by_model[kv(r["reason"]).get("model") or "(sem registro)"].append(r)
    print("Comparação por modelo (delegações do bulk-read)")
    print(f"  {'modelo':<22} {'deleg.':>7} {'erros':>6} {'enviados':>9} "
          f"{'devolvidos':>11} {'razão':>6} {'s/deleg':>8} {'tok/s':>6}")
    for model in sorted(by_model):
        ok = [r for r in by_model[model] if r["decision"] == "ok"]
        errors = len(by_model[model]) - len(ok)
        if not ok:
            print(f"  {model:<22} {0:>7} {errors:>6}")
            continue
        sent = sum(kv(r["reason"]).get("pin", 0) for r in ok)
        returned = sum(kv(r["reason"]).get("pout", 0) for r in ok)
        seconds = sum(kv(r["reason"]).get("dur", 0) for r in ok)
        ratios = [kv(r["reason"])["ratio"] for r in ok
                  if "ratio" in kv(r["reason"])]
        ratio = f"{statistics.median(ratios):.0f}%" if ratios else "-"
        rate = f"{(sent + returned) / seconds:.0f}" if seconds else "-"
        print(f"  {model:<22} {len(ok):>7} {errors:>6} {sent:>9} "
              f"{returned:>11} {ratio:>6} {seconds / len(ok):>8.0f} {rate:>6}")
    print()


def median_ratio(reasons):
    ratios = [k["ratio"] for k in reasons if "ratio" in k]
    return f"{statistics.median(ratios):.0f}%" if ratios else "-"


def print_subtask_split(rows):
    """Razão mediana com e sem --questions: é o que diz se decompor comprimiu."""
    reasons = [kv(r["reason"]) for r in rows
               if r["tool"] == "bulk-read" and r["decision"] == "ok"]
    decomposed = [k for k in reasons if k.get("subtasks", 0) > 1]
    if not decomposed:
        return
    plain = [k for k in reasons if k.get("subtasks", 0) <= 1]
    print(f"  com subtarefas (--questions): {len(decomposed)} delegação(ões), razão mediana "
          f"{median_ratio(decomposed)} contra {median_ratio(plain)} das {len(plain)} "
          "sem decomposição")


def fmt_bytes(n):
    return f"{n / 1024:.1f} KB" if n else "-"


class Follower:
    """Pareia negativas com delegações à medida que as linhas chegam.

    Separado do laço de leitura para ser testável sem esperar dez minutos:
    feed() recebe uma linha parseada e tick() o relógio, e os dois devolvem
    as linhas a imprimir. Uma negativa vira "sem delegação" quando a janela
    de conversão passa sem um bulk-read, que é o sinal de que o Claude
    desistiu da informação em vez de delegar.
    """

    def __init__(self, show_all=False):
        self.show_all = show_all
        self.pending = []   # negativas ainda sem delegação, em ordem

    @staticmethod
    def clock(row):
        return row["ts"].strftime("%H:%M:%S")

    def feed(self, row):
        out = []
        if row["tool"] == "bulk-read":
            out.append(self._delegation(row))
        elif row["decision"] == "deny":
            self.pending.append(row)
            out.append(f"{self.clock(row)}  deny   {row['path']}  "
                       f"{fmt_bytes(row['read_bytes'])} fora do contexto "
                       f"({row['reason'].split(':')[0]})")
        elif self.show_all and row["tool"] not in NOT_HOOK:
            out.append(f"{self.clock(row)}  {row['decision']:<6} {row['path']}  "
                       f"{fmt_bytes(row['read_bytes'])} ({row['reason'].split(':')[0]})")
        return out

    def _delegation(self, row):
        k = kv(row["reason"])
        origin = ""
        deny = pick_deny(self.pending, row)
        if deny is not None:
            wait = int((row["ts"] - deny["ts"]).total_seconds())
            how = "" if deny["path"] == row["path"] else ", por tempo"
            origin = f"  <- negativa de {self.clock(deny)} ({wait}s{how})"
            self.pending.remove(deny)
        if row["decision"] != "ok":
            return (f"{self.clock(row)}  ERRO   bulk-read {row['reason']}{origin}")
        return (f"{self.clock(row)}  ok     bulk-read pin={k.get('pin', 0)} "
                f"pout={k.get('pout', 0)} razão {k.get('ratio', '-')}% "
                f"{k.get('dur', 0)}s {k.get('model', '')}{origin}")

    def tick(self, now):
        out = []
        expired = [d for d in self.pending if now > d["ts"] + CONVERSION_WINDOW]
        for d in expired:
            out.append(f"{now.strftime('%H:%M:%S')}  --     negativa de {self.clock(d)} "
                       f"em {d['path']} sem delegação em 10 min")
        self.pending = [d for d in self.pending if d not in expired]
        return out


def follow(path, show_all):
    """Acompanha o log a partir do fim, como tail -f, imprimindo só o que conta."""
    follower = Follower(show_all)
    print(f"acompanhando {path} (negativas e delegações; Ctrl-C para sair)", flush=True)
    try:
        fh = open(path, encoding="utf-8")
    except OSError:
        sys.exit(f"log não encontrado: {path}")
    fh.seek(0, os.SEEK_END)
    try:
        while True:
            line = fh.readline()
            if line:
                row = parse_line(line)
                if row:
                    for text in follower.feed(row):
                        print(text, flush=True)
                continue
            for text in follower.tick(dt.datetime.now()):
                print(text, flush=True)
            # Log truncado ou recriado: recomeça do início do arquivo novo.
            if os.path.getsize(path) < fh.tell():
                fh.close()
                fh = open(path, encoding="utf-8")
            time.sleep(0.5)
    except KeyboardInterrupt:
        print()
    finally:
        fh.close()


def coverage_rows(rows):
    """Maior cobertura alcançada por (sessão, arquivo), direto da coluna 11."""
    best = {}
    slices = collections.Counter()
    reads = collections.Counter()
    for r in rows:
        if r["tool"] in NOT_HOOK or r["path"] == "-" or not r["total"]:
            continue
        key = (r["session"], r["path"])
        if r["decision"] == "allow":
            reads[key] += 1
            fatia = (r["read_bytes"] <= SLICE_BYTES if r["read_bytes"]
                     else r["eff"] <= SLICE_LINES)
            if fatia:
                slices[key] += 1
            base = r["total_bytes"] or r["total"]
            atual = r["covered"]
            if atual > best.get(key, (0, 0))[0]:
                best[key] = (atual, base, r["version"],
                             bool(r["total_bytes"]))
    out = []
    for key, (cov, total, ver, em_bytes) in best.items():
        if cov and total:
            out.append({"session": key[0], "path": key[1], "covered": cov,
                        "total": total, "pct": 100 * cov / total,
                        "reads": reads[key], "slices": slices[key],
                        "version": ver, "bytes": em_bytes})
    return out


def print_coverage(rows, top):
    cov = coverage_rows(rows)
    if not cov:
        print("Cobertura por arquivo: sem dados. Linhas anteriores à 0.5.0 não\n"
              "registram faixas; use o log novo para esta seção.\n")
        return
    em_bytes = sum(1 for r in cov if r["bytes"])
    unidade = "bytes" if em_bytes >= len(cov) / 2 else "linhas"
    print(f"Cobertura por arquivo e sessão, em {unidade} "
          f"(top {top} por percentual)")
    print(f"  {'coberto':>8} {'total':>7} {'%':>5} {'leituras':>9} "
          f"{'fatias':>7}  arquivo")
    for r in sorted(cov, key=lambda x: (-x["pct"], -x["covered"]))[:top]:
        name = f"{os.path.basename(os.path.dirname(r['path']))}/{os.path.basename(r['path'])}"
        print(f"  {r['covered']:>8} {r['total']:>7} {r['pct']:>4.0f}% "
              f"{r['reads']:>9} {r['slices']:>7}  {name}")

    # Fatiamento: arquivo acima do limiar, muita cobertura, leituras pequenas.
    sliced = [r for r in cov
              if r["pct"] >= 50 and r["reads"] >= 3
              and r["slices"] >= r["reads"] - 1]
    print(f"\n  Fatiamento: {len(sliced)} arquivo(s) com 50%+ de cobertura "
          f"montada em 3+ leituras pequenas")
    if sliced:
        for r in sorted(sliced, key=lambda x: -x["covered"])[:top]:
            name = os.path.basename(r["path"])
            print(f"    {r['covered']:>6} de {r['total']:<6} em "
                  f"{r['reads']:>2} leituras  {name}")
        print("    Se esses arquivos são grandes, o orçamento por arquivo está "
              "frouxo:\n    considere baixar SHUNT_MIN_BYTES ou "
              "SHUNT_ESCAPE_BYTES.")
    print()


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--log", default=DEFAULT_LOG)
    ap.add_argument("--since", help="AAAA-MM-DD")
    ap.add_argument("--version", help="filtra uma versão do plugin")
    ap.add_argument("--model", help="filtra um modelo do Ollama (delegações)")
    ap.add_argument("--file", help="filtra arquivos cujo caminho contém o trecho")
    ap.add_argument("--top", type=int, default=10, help="linhas por seção")
    ap.add_argument("--follow", action="store_true",
                    help="acompanha o log ao vivo: negativas, delegações e pareamento")
    ap.add_argument("--all", action="store_true",
                    help="com --follow, mostra também allow e skip")
    args = ap.parse_args()
    if args.follow:
        follow(args.log, args.all)
        return

    since = dt.datetime.fromisoformat(args.since) if args.since else None
    rows = []
    try:
        with open(args.log, encoding="utf-8") as fh:
            for line in fh:
                row = parse_line(line)
                if not row:
                    continue
                if since and row["ts"] < since:
                    continue
                if args.version and row["version"] != args.version:
                    continue
                if args.model and row["tool"] == "bulk-read" \
                        and kv(row["reason"]).get("model") != args.model:
                    continue
                if args.file and args.file not in row["path"]:
                    continue
                rows.append(row)
    except OSError:
        sys.exit(f"log não encontrado: {args.log}")
    if not rows:
        sys.exit("sem registros que casem com os filtros.")

    overall = summarize(rows)
    print(f"shunt-stats — {rows[0]['ts']:%Y-%m-%d} a {rows[-1]['ts']:%Y-%m-%d} "
          f"| sessões: {overall['sessions']}\n")

    print_version_table(rows)
    print_model_table(rows)
    print_coverage(rows, args.top)

    hooks = [r for r in rows if r["tool"] not in NOT_HOOK]
    denies = [r for r in hooks if r["decision"] == "deny"]

    print("Decisões dos hooks (versão / ferramenta / decisão / motivo):")
    counter = collections.Counter(
        (r["version"], r["tool"], r["decision"], r["reason"].split(":")[0])
        for r in hooks)
    for (ver, tool, dec, reason), n in sorted(counter.items(),
                                              key=lambda x: -x[1])[:args.top * 2]:
        print(f"  {n:>5}  {ver:<9} {tool:<42} {dec:<6} {reason}")

    if denies:
        print("\nArquivos mais bloqueados:")
        for path, n in collections.Counter(
                r["path"] for r in denies).most_common(args.top):
            print(f"  {n:>5}  {path}")
        if overall["blocked_bytes"]:
            tokens = int(overall["blocked_bytes"] / BYTES_PER_TOKEN)
            print(f"\nBloqueado: {overall['blocked_bytes']} bytes "
                  f"(~{tokens} tokens a {BYTES_PER_TOKEN} bytes/token), "
                  f"em {overall['blocked']} linhas")
        else:
            print(f"\nLinhas que os denies impediram de entrar no contexto: "
                  f"{overall['blocked']} (registro anterior à 0.9.0, sem bytes)")

    print(f"\nbulk-read: {overall['delegations']} delegação(ões) bem-sucedida(s)"
          + (f", {overall['delegation_errors']} com erro"
             if overall["delegation_errors"] else ""))
    if overall["delegations"]:
        print(f"  arquivos lidos pelo modelo local: {overall['files']}")
        print(f"  tokens enviados ao Ollama (fora do Claude): {overall['sent']}")
        print(f"  tokens devolvidos ao Claude: {overall['returned']}")
        print(f"  economia líquida estimada: "
              f"{overall['sent'] - overall['returned']} tokens "
              f"| tempo total: {overall['seconds']}s")
        print_subtask_split(rows)
        ratios = overall["ratios"]
        if ratios:
            poor = [r for r in ratios if r >= 50]
            print(f"  resposta em % do conteúdo lido: mediana "
                  f"{statistics.median(ratios):.0f}%, pior {max(ratios)}%")
            if poor:
                print(f"  {len(poor)} de {len(ratios)} delegações renderam pouco "
                      "(50%+). Pergunta ampla faz o modelo local enumerar tudo:\n"
                      "  pergunte o que precisa, não um panorama.")

    if denies:
        pct = 100 * overall["converted"] / len(denies)
        print(f"\nConversão: {overall['converted']}/{len(denies)} denies "
              f"({pct:.0f}%) atendidos por um bulk-read em até 10 min")
        print_conversion_by_tool(denies, [r for r in rows if r["tool"] == "bulk-read"
                                          and r["decision"] == "ok"])
        if pct < 20:
            print("  Conversão baixa: os bloqueios estão economizando contexto, "
                  "mas o Claude está desistindo da informação em vez de delegar.")


if __name__ == "__main__":
    main()
