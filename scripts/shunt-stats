#!/usr/bin/env python3
"""Resume o log do shunt: decisões dos hooks, delegações ao bulk-read e tokens
que ficaram fora do contexto do Claude.

Uso: shunt-stats [--log CAMINHO] [--since 2026-09-01]
"""

import argparse
import collections
import datetime as dt
import os
import sys

DEFAULT_LOG = os.environ.get("SHUNT_HOOK_LOG") or os.path.expanduser("~/.claude/shunt.log")
CONVERSION_WINDOW = dt.timedelta(minutes=10)


def parse_line(line):
    cols = line.rstrip("\n").split("\t")
    if len(cols) != 8:
        return None  # formato antigo (0.1.0) ou linha corrompida
    try:
        ts = dt.datetime.fromisoformat(cols[0])
    except ValueError:
        return None
    return {"ts": ts, "session": cols[1], "tool": cols[2], "decision": cols[3],
            "reason": cols[4], "path": cols[5], "total": int(cols[6] or 0),
            "eff": int(cols[7] or 0)}


def kv(reason):
    out = {}
    for part in reason.split(";"):
        if "=" in part:
            k, v = part.split("=", 1)
            out[k] = int(v) if v.isdigit() else v
    return out


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--log", default=DEFAULT_LOG)
    ap.add_argument("--since", help="AAAA-MM-DD")
    args = ap.parse_args()

    since = dt.datetime.fromisoformat(args.since) if args.since else None
    rows = []
    try:
        with open(args.log, encoding="utf-8") as fh:
            for line in fh:
                row = parse_line(line)
                if row and (since is None or row["ts"] >= since):
                    rows.append(row)
    except OSError:
        sys.exit(f"log não encontrado: {args.log}")
    if not rows:
        sys.exit("sem registros no formato 0.2.0 (nada interceptado ainda).")

    hooks = [r for r in rows if r["tool"] not in ("bulk-read", "SessionStart")]
    bulk = [r for r in rows if r["tool"] == "bulk-read" and r["decision"] == "ok"]
    denies = [r for r in hooks if r["decision"] == "deny"]

    print(f"shunt-stats — {rows[0]['ts']:%Y-%m-%d} a {rows[-1]['ts']:%Y-%m-%d} "
          f"| sessões: {len({r['session'] for r in hooks if r['session'] != '-'})}")
    print("\nDecisões dos hooks (ferramenta / decisão / motivo):")
    counter = collections.Counter(
        (r["tool"], r["decision"], r["reason"].split(":")[0]) for r in hooks)
    for (tool, dec, reason), n in sorted(counter.items(), key=lambda x: -x[1])[:20]:
        print(f"  {n:>5}  {tool:<45} {dec:<6} {reason}")

    if denies:
        print("\nArquivos mais bloqueados:")
        top = collections.Counter(r["path"] for r in denies).most_common(10)
        for path, n in top:
            print(f"  {n:>5}  {path}")
        blocked_lines = sum(r["eff"] for r in denies)
        print(f"\nLinhas que os denies impediram de entrar no contexto: {blocked_lines} "
              f"(~{blocked_lines * 12 // 1} tokens estimados a 12 tokens/linha)")

    print(f"\nbulk-read: {len(bulk)} delegação(ões)")
    if bulk:
        pin = sum(kv(r["reason"]).get("pin", 0) for r in bulk)
        pout = sum(kv(r["reason"]).get("pout", 0) for r in bulk)
        dur = sum(kv(r["reason"]).get("dur", 0) for r in bulk)
        files = sum(kv(r["reason"]).get("files", 0) for r in bulk)
        print(f"  arquivos lidos pelo modelo local: {files}")
        print(f"  tokens enviados ao Ollama (fora do Claude): {pin}")
        print(f"  tokens devolvidos ao Claude: {pout}")
        print(f"  economia líquida estimada: {pin - pout} tokens | tempo total: {dur}s")

    if denies:
        converted = 0
        bulk_times = [r["ts"] for r in bulk]
        for d in denies:
            if any(d["ts"] <= t <= d["ts"] + CONVERSION_WINDOW for t in bulk_times):
                converted += 1
        pct = 100 * converted / len(denies)
        print(f"\nConversão: {converted}/{len(denies)} denies ({pct:.0f}%) "
              "seguidos de bulk-read em até 10 min")


if __name__ == "__main__":
    main()
