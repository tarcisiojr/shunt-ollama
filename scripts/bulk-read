#!/bin/bash
# Delegar a leitura de arquivos grandes ao modelo local (equivalente ao
# mode "bulk-reader" do AiKA).
#
# Uso:
#   bulk-read --question "o que esse serviço faz?" --paths a.java b.java dir/
#   bulk-read --question "..." --glob 'src/**/*.rs'
#   bulk-read --question "o que mudou e onde?" --cmd "git diff main"
#   git diff | bulk-read --question "..." --stdin
#
# Cada arquivo vai numerado (cat -n) em <file path="..." lines="a-b">. O que não
# cabe em SHUNT_NUM_CTX é fatiado em partes, cada uma com pergunta própria.

set -o pipefail
SHUNT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$SHUNT_ROOT/scripts/lib/ollama.sh"

MODES_DIR="$(cd "$(dirname "$0")/.." && pwd)/modes"
DEFAULT_QUESTION="Liste os símbolos públicos/exportados com a responsabilidade de cada um, as dependências entre eles e os pontos de entrada."

usage() {
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
}

question=""
paths=()
globs=()
cmd=""
use_stdin=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --question) question="$2"; shift 2 ;;
    --paths)    shift; while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do paths+=("$1"); shift; done ;;
    --glob)     shift; while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do globs+=("$1"); shift; done ;;
    --cmd)      cmd="$2"; shift 2 ;;
    --stdin)    use_stdin=1; shift ;;
    -h|--help)  usage; exit 0 ;;
    *)          echo "Error: argumento desconhecido: $1" >&2; usage >&2; exit 1 ;;
  esac
done

[ -z "$question" ] && question="$DEFAULT_QUESTION"

# ---------------------------------------------------------------------------
# Fontes: arquivos (paths, diretórios, globs), saída de comando, stdin.
# Um path digitado errado viraria um <file> vazio e uma resposta confiante
# sobre nada — falhar alto é melhor.
# ---------------------------------------------------------------------------
src_files=()   # arquivo real a ler
src_labels=()  # rótulo que vai na tag
cmd_out=""; stdin_out=""; numbered=""  # preenchidos por shunt_tmpfile (printf -v)
chunk_tokens=0; chunk_timeout=0; chunk_bytes=0; chunk_floor=0

add_source() {
  local file="$1" label="$2"
  if ! grep -Iq . "$file" 2>/dev/null; then
    echo "[shunt: ignorando binário/vazio: $label]" >&2
    return
  fi
  local seen
  for seen in "${src_labels[@]}"; do [ "$seen" = "$label" ] && return; done
  src_files+=("$file"); src_labels+=("$label")
}

for path in "${paths[@]}"; do
  if [ -d "$path" ]; then
    while IFS= read -r f; do add_source "$f" "$f"; done < <(
      find "$path" -type f -not -path '*/.git/*' -not -path '*/node_modules/*' | sort)
  elif [ -f "$path" ] && [ -r "$path" ]; then
    add_source "$path" "$path"
  else
    echo "Error: file not found or unreadable: $path" >&2
    exit 1
  fi
done

if [ ${#globs[@]} -gt 0 ]; then
  shopt -s globstar nullglob
  for pattern in "${globs[@]}"; do
    # shellcheck disable=SC2086
    for f in $pattern; do [ -f "$f" ] && add_source "$f" "$f"; done
  done
  shopt -u globstar nullglob
fi

shunt_preflight || exit 1

if [ -n "$cmd" ]; then
  shunt_tmpfile cmd_out || exit 1
  bash -c "$cmd" > "$cmd_out" 2>&1
  add_source "$cmd_out" "cmd: $cmd"
fi
if [ "$use_stdin" -eq 1 ]; then
  shunt_tmpfile stdin_out || exit 1
  cat > "$stdin_out"
  add_source "$stdin_out" "stdin"
fi

if [ ${#src_files[@]} -eq 0 ]; then
  echo "Error: nenhuma fonte legível (--paths, --glob, --cmd ou --stdin)" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Orçamento e fatiamento, dimensionados para o teto real do prompt e pelo
# pior caso de bytes por token: ver shunt_chunk_budget.
# ---------------------------------------------------------------------------
budget_chars="$(shunt_chunk_budget)"

chunks=()        # arquivos de mensagem prontos
chunk_labels=()  # descrição de cada parte
current=""
current_size=0
current_label=""

new_chunk() { shunt_tmpfile current || exit 1; current_size=0; current_label=""; }
flush_chunk() {
  if [ -n "$current" ] && [ "$current_size" -gt 0 ]; then
    chunks+=("$current"); chunk_labels+=("$current_label")
  fi
  current=""
}
# add_block <label> <arquivo numerado> <ini> <fim> <total>
add_block() {
  local label="$1" numbered="$2" start="$3" end="$4" total="$5"
  [ -z "$current" ] && new_chunk
  {
    printf '<file path="%s" lines="%s-%s" total="%s">\n' "$label" "$start" "$end" "$total"
    sed -n "${start},${end}p" "$numbered"
    printf '</file>\n\n'
  } >> "$current"
  current_size=$(wc -c < "$current" | tr -d ' ')
  current_label="${current_label:+$current_label, }$label:L$start-L$end"
}

# Labels reais para a restauração de caminho em shunt_invoke.
shunt_tmpfile SHUNT_LABELS_FILE || exit 1
printf '%s\n' "${src_labels[@]}" > "$SHUNT_LABELS_FILE"
export SHUNT_LABELS_FILE

total_lines_all=0
for i in "${!src_files[@]}"; do
  file="${src_files[$i]}"; label="${src_labels[$i]}"
  shunt_tmpfile numbered || exit 1
  cat -n "$file" > "$numbered"
  size=$(wc -c < "$numbered" | tr -d ' ')
  total=$(wc -l < "$file" | tr -d ' ')
  total_lines_all=$((total_lines_all + total))
  [ "$total" -eq 0 ] && continue

  if [ "$size" -gt "$budget_chars" ]; then
    # Arquivo maior que a janela: partes por faixa de linhas, numeração original.
    flush_chunk
    per_chunk=$(( total * budget_chars / size ))
    [ "$per_chunk" -lt 50 ] && per_chunk=50
    start=1
    while [ "$start" -le "$total" ]; do
      end=$(( start + per_chunk - 1 )); [ "$end" -gt "$total" ] && end=$total
      add_block "$label" "$numbered" "$start" "$end" "$total"
      flush_chunk
      start=$(( end + 1 ))
    done
  else
    if [ -n "$current" ] && [ $((current_size + size)) -gt "$budget_chars" ]; then
      flush_chunk
    fi
    add_block "$label" "$numbered" 1 "$total" "$total"
  fi
done
flush_chunk

n=${#chunks[@]}
for i in "${!chunks[@]}"; do
  printf 'Question: %s\n' "$question" >> "${chunks[$i]}"
  if [ "$n" -gt 1 ]; then
    printf -- '- Parte %d/%d (%s):\n' "$((i + 1))" "$n" "${chunk_labels[$i]}"
  fi
  chunk_bytes="$(wc -c < "${chunks[$i]}" | tr -d ' ')"
  # Duas contas com propósitos opostos: o máximo dimensiona o timeout, o
  # mínimo serve de piso para acusar truncamento sem falso positivo.
  chunk_tokens="$(shunt_tokens_for_bytes "$chunk_bytes")"
  chunk_floor="$(shunt_min_tokens_for_bytes "$chunk_bytes")"
  chunk_timeout="$(shunt_timeout_for "$chunk_tokens")"
  shunt_invoke "$MODES_DIR/bulk-reader.md" "${chunks[$i]}" \
    "$chunk_floor" "$chunk_timeout" || exit 1
done

char_count=0
for c in "${chunks[@]}"; do char_count=$((char_count + $(wc -c < "$c" | tr -d ' '))); done
content_tokens=$((char_count / 4))
echo "[shunt: ~$content_tokens tokens que o Claude NÃO gastou lendo | ${#src_files[@]} fonte(s), $n parte(s) | delegado a bulk-reader]" >&2

# A delegação só compensa se a resposta for bem menor que o conteúdo enviado.
# A comparação é contra o conteúdo, e não contra o prompt_eval_count do Ollama,
# porque aquele soma o system prompt e faria qualquer razão parecer ótima.
ratio=0
if [ "$content_tokens" -gt 0 ]; then
  ratio=$((SHUNT_POUT_TOTAL * 100 / content_tokens))
  if [ "$ratio" -ge 100 ]; then
    echo "[shunt: ATENÇÃO — a resposta ($SHUNT_POUT_TOTAL tokens) ficou maior que o conteúdo lido (~$content_tokens). Não houve economia: ler o arquivo direto custaria o mesmo. Refaça com uma pergunta específica em vez de pedir um panorama.]" >&2
  elif [ "$ratio" -ge "$SHUNT_WARN_RATIO" ]; then
    echo "[shunt: aviso — a resposta ocupou ${ratio}% do conteúdo lido. Perguntas específicas comprimem muito mais; considere refazer perguntando só o que precisa.]" >&2
  fi
fi
shunt_log_line bulk-read ok \
  "model=$SHUNT_MODEL;files=${#src_files[@]};chunks=$n;pin=$SHUNT_PIN_TOTAL;pout=$SHUNT_POUT_TOTAL;dur=$SHUNT_DUR_TOTAL;ratio=$ratio" \
  "${src_labels[0]}" "$total_lines_all" 0
