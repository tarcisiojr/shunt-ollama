#!/usr/bin/env python3
"""Hook PreToolUse para Read: bloqueia leituras grandes e manda para o bulk-read.

Diferente da versão original, `offset`/`limit` não garantem passagem: o que
conta são as linhas efetivas pedidas e o acumulado já lido do arquivo na sessão.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))

import shunt_common as sc  # noqa: E402


def main() -> None:
    data = sc.read_hook_input()
    tool_input = data.get("tool_input") or {}
    path = tool_input.get("file_path") or ""
    session = data.get("session_id") or ""

    if not path or not sc.is_regular_file(path):
        sc.allow()

    offset = tool_input.get("offset")
    limit = tool_input.get("limit")
    start = int(offset) if isinstance(offset, int) and offset > 0 else 1
    end = start + int(limit) - 1 if isinstance(limit, int) and limit > 0 else None
    sc.decide(session, "Read", {os.path.normpath(path): [(start, end)]})


if __name__ == "__main__":
    main()
