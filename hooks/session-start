#!/usr/bin/env python3
"""Hook SessionStart: injeta a regra de roteamento de leitura no contexto.

Sem isso o modelo só descobre o shunt quando um deny acontece, e a reação
natural a um bloqueio é tentar contornar.

O texto descreve o caminho certo sem publicar os números que definem os
limites. Uma versão anterior listava o tamanho das leituras que passavam
livres, e a análise do log mostrou o resultado: 41% das leituras couberam
exatamente na faixa isenta, e arquivos acima do limiar chegaram ao contexto
inteiros, montados em fatias. Um limite publicado é um mapa de contorno.

Diz a unidade, no entanto: sem saber que o custo é em bytes, o modelo trata um
JSON de uma linha como um arquivo pequeno.
"""

import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))

import shunt_common as sc  # noqa: E402


def routing_text(ollama_up: bool) -> str:
    status = ("Ollama disponível." if ollama_up else
              "Ollama INDISPONÍVEL: os bloqueios ficam desativados até "
              "`ollama serve` responder.")
    return (
        "[shunt-ollama] Roteamento de leitura de arquivos.\n"
        "- Cada arquivo grande tem um orçamento de leitura por sessão. Read, "
        "cat, head, tail, sed -n e awk consomem esse orçamento, inclusive "
        "dentro de ferramentas MCP que executam shell. Quando ele acaba, a "
        "leitura é bloqueada.\n"
        "- O orçamento é do arquivo, não da leitura: dividir em pedaços não "
        "aumenta o que você consegue ler, porque as faixas são somadas.\n"
        "- O que conta é o tamanho em bytes, não o número de linhas. Poucas "
        "linhas densas, como um JSON minificado, custam mais contexto que "
        "muitas linhas curtas.\n"
        "- Para entender, resumir ou responder perguntas sobre arquivo grande, "
        "diff grande ou vários arquivos, delegue ao modelo local:\n"
        f"    {sc.BULK_READ} --question \"<pergunta específica>\" --paths <arquivos>\n"
        "  Variantes: --cmd \"git diff main\" | --glob 'src/**/*.rs' | --stdin. "
        "A resposta vem em bullets `Nome (path:Lini-Lfim)`, custa 0 tokens do "
        "seu contexto e leva dezenas de segundos. Pergunta específica comprime "
        "bem; pergunta vaga faz o modelo enumerar tudo.\n"
        "- Depois de delegar, abra com Read apenas o trecho que vai editar, "
        "usando as linhas que a resposta apontou.\n"
        "- Para LOCALIZAR um símbolo use grep/rg, que não consome orçamento.\n"
        f"- {status}"
    )


def main() -> None:
    data = sc.read_hook_input()
    session = data.get("session_id") or ""
    with sc.State(session) as state:
        up = state.ollama_ok()
    sc.log(session, "SessionStart", "info", "ollama-up" if up else "ollama-down")
    if sc.MIN_BYTES_ADJUSTED:
        sc.log(session, "SessionStart", "info",
               f"threshold-floor:{sc.MIN_BYTES}")
    out = {"hookSpecificOutput": {"hookEventName": "SessionStart",
                                  "additionalContext": routing_text(up)}}
    print(json.dumps(out, ensure_ascii=False))


if __name__ == "__main__":
    main()
